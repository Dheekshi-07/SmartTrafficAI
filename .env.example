# =================================================================
# SmartTrafficAI - Environment Configuration Template
# =================================================================

# FastAPI Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# SUMO Simulation Engine
SUMO_BINARY=sumo
# Example Linux/macOS paths:
# SUMO_HOME=/Library/Frameworks/EclipseSUMO.framework/Versions/1.27.1/EclipseSUMO
# SUMO_HOME=/usr/share/sumo

# Arduino Physical Hardware Serial Configuration
SERIAL_PORT=/dev/tty.usbmodem1101
SERIAL_BAUDRATE=9600

# Frontend API Gateway Endpoint
VITE_API_URL=http://localhost:8000
