# ============================================
# SmartTrafficAI - Git Ignore
# ============================================

# Python virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter temporary files
.ipynb_checkpoints/
Untitled.ipynb

# Environment / secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# VS Code
.vscode/

# Node / React
frontend/node_modules/
frontend/dist/
node_modules/
dist/

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Coverage / testing cache
.pytest_cache/
.coverage
htmlcov/

# IDE files
.idea/

# SUMO temporary/debug files
*.log
*.bak

# Keep actual project evidence/results
!results/
!results/*.csv
!results/*.png
!results/*.xml
!results/*.txt

# Keep trained project model
!models/
!models/*.joblib